# ---------------------------------------------------------------------------
# Sanchay environment (copy to .env.local - never commit real values)
# Same layout as EasyLife: Prisma -> Supabase PostgreSQL, server-side access only.
# ---------------------------------------------------------------------------

# Local embedded Postgres (port 54329) or Supabase transaction pooler (port 6543, ?pgbouncer=true)
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/sanchay"
# Local embedded Postgres (port 54329) or Supabase direct / session connection (port 5432)
DIRECT_URL="postgresql://postgres:postgres@localhost:54329/sanchay"

NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# Publishable key (sb_publishable_...). Fallback: NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-key"

# Server-side Supabase values (same project URL/keys under non-public names).
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-key"
# Server-only secret key (sb_secret_...). Used for Storage (vehicle photos, incident evidence)
# and admin clients. Never expose to the browser. Fallback: SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY="sb_secret_your-key"
SUPABASE_JWKS_URL="https://your-project.supabase.co/auth/v1/.well-known/jwks.json"
SUPABASE_STORAGE_BUCKET="sanchay-files"

# Bootstrap administrator (works before any Operator rows exist; create real operators in Settings)
SANCHAY_ADMIN_USERNAME="admin"
SANCHAY_ADMIN_PASSWORD="change-this-password"
# Long random secret used to HMAC-sign session cookies
SANCHAY_AUTH_SECRET="replace-with-a-long-random-secret"

# IoT / GPS gateway ingest (placeholder endpoint /api/iot/ingest). Gateways send: Authorization: Bearer <token>
SANCHAY_IOT_INGEST_TOKEN="replace-with-a-long-random-device-token"

# Vercel Cron -> /api/cloud/sync-jobs/process
CRON_SECRET="replace-with-a-cron-secret"

# Optional: basemap provider (defaults to OpenStreetMap tiles; use a keyed provider in production)
# NEXT_PUBLIC_MAP_TILES_URL=https://tile.example.com/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=(c) Provider
# NEXT_PUBLIC_MAP_GLYPHS_URL=https://tiles.example.com/fonts/{fontstack}/{range}.pbf

# ---- AI providers (all optional; leave blank to disable a provider). Server-side only. ----
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openrouter/free
GROQ_API_KEY=
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=pixtral-12b-2409

# ---- Mapbox (address search + reverse geocoding). Public pk. token, browser-restricted in the
# Mapbox dashboard. Leave blank to disable address search; the app keeps working with free text.
# Supports MAPBOX_ACCESS_TOKEN, NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN, or MapBox_Token.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
MAPBOX_ACCESS_TOKEN=
MapBox_Token=

# ---- eCourts India (court case evidence for the vehicles module). SERVER-ONLY bearer token.
# Leave blank to disable the legal-review lookup. Supports ECOURTS_API_TOKEN or eCourt_Token.
ECOURTS_API_TOKEN=
eCourt_Token=
ECOURTS_API_BASE_URL=https://webapi.ecourtsindia.com

